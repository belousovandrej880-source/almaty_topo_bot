@dp.message(F.web_app_data)
async def on_webapp_data(message: Message):
    raw = message.web_app_data.data
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        await message.answer(f"Получены данные: {raw}")
        return

    if data.get("action") == "route_key":
        gear_list = ", ".join(data.get("gear") or []) or "по рельефу"
        text = (
            f"<b>#{data.get('number')} {data.get('title')}</b> ({data.get('grade')}, {data.get('length')})\n"
            f"Локация: {data.get('sector')}\n"
            f"Железо: {gear_list}\n\n"
            f"{data.get('summary', '')}"
        )
        await message.answer(text, parse_mode="HTML")


async def main():
    bot = Bot(token=BOT_TOKEN)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
